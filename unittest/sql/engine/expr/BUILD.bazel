load("@rules_cc//cc:cc_test.bzl", "cc_test")
load("//bazel:defs.bzl", "cc_library")

package(default_testonly = True)

[
    cc_library(
        name = name + "_cases",
        srcs = [name + ".cpp"],
        alwayslink = True,
        deps = [
            "//bazel/third_party:gtest",
            "//src/sql:ai_function_test_headers",
        ],
    )
    for name in ["ob_expr_ai_prompt_test", "test_ob_openai_utils"]
]

[
    cc_test(
        name = name,
        size = "small",
        linkstatic = True,
        features = ["-static_cpp_runtime", "-static_link_cpp_runtimes"],
        deps = [
            ":" + name + "_cases",
            "//src/observer:liboceanbase",
        ],
        target_compatible_with = ["@platforms//os:linux"],
    )
    for name in ["ob_expr_ai_prompt_test", "test_ob_openai_utils"]
]
